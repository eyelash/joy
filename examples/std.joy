builtin type Type();
builtin type Int();
builtin type String();
builtin type Tuple(...Types);
builtin type Array(T: Type());
builtin type Function(name: String(), ...arguments);

func Unit(): Type() => Tuple();

builtin func __builtin_joy_int_add(lhs: Int(), rhs: Int()): Int();
builtin func __builtin_joy_int_subtract(lhs: Int(), rhs: Int()): Int();
builtin func __builtin_joy_int_multiply(lhs: Int(), rhs: Int()): Int();
builtin func __builtin_joy_int_divide(lhs: Int(), rhs: Int()): Int();
builtin func __builtin_joy_int_remainder(lhs: Int(), rhs: Int()): Int();
builtin func __builtin_joy_int_equal(lhs: Int(), rhs: Int()): Int();
builtin func __builtin_joy_int_not_equal(lhs: Int(), rhs: Int()): Int();
builtin func __builtin_joy_int_less_than(lhs: Int(), rhs: Int()): Int();
builtin func __builtin_joy_int_less_than_or_equal(lhs: Int(), rhs: Int()): Int();
builtin func __builtin_joy_putchar(c: Int()): Unit();
builtin func __builtin_joy_debug_print(...arguments): Unit();

func Bool(): Type() => Int();

struct Char() {
	c: Int()
}

func char(c: Int()): Char() {
	return new Char() {
		c = c
	};
}

// Int arithmetic operators
func add      (lhs: Int(), rhs: Int()): Int() => __builtin_joy_int_add      (lhs, rhs);
func subtract (lhs: Int(), rhs: Int()): Int() => __builtin_joy_int_subtract (lhs, rhs);
func multiply (lhs: Int(), rhs: Int()): Int() => __builtin_joy_int_multiply (lhs, rhs);
func divide   (lhs: Int(), rhs: Int()): Int() => __builtin_joy_int_divide   (lhs, rhs);
func remainder(lhs: Int(), rhs: Int()): Int() => __builtin_joy_int_remainder(lhs, rhs);

func negate(int: Int()): Int() => __builtin_joy_int_subtract(0, int);

// Int relational operators
func equal                (lhs: Int(), rhs: Int()): Bool() => __builtin_joy_int_equal             (lhs, rhs);
func not_equal            (lhs: Int(), rhs: Int()): Bool() => __builtin_joy_int_not_equal         (lhs, rhs);
func less_than            (lhs: Int(), rhs: Int()): Bool() => __builtin_joy_int_less_than         (lhs, rhs);
func less_than_or_equal   (lhs: Int(), rhs: Int()): Bool() => __builtin_joy_int_less_than_or_equal(lhs, rhs);
func greater_than         (lhs: Int(), rhs: Int()): Bool() => __builtin_joy_int_less_than         (rhs, lhs);
func greater_than_or_equal(lhs: Int(), rhs: Int()): Bool() => __builtin_joy_int_less_than_or_equal(rhs, lhs);

func putchar(c: Int()): Unit() => __builtin_joy_putchar(c);

func print(c: Char()): Unit() {
	__builtin_joy_putchar(c.c);
}

func print(n: Int()): Unit() {
	if (n < 0) {
		print(char('-'));
		n = 0 - n;
	}
	if (n >= 10) {
		print(n / 10);
	}
	print(char('0' + n % 10));
}

func println(t): Unit() {
	print(t);
	print(char('\n'));
}
func println(): Unit() {
	print(char('\n'));
}
